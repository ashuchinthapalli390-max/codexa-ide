# ==============================================================================
# CODEXA STUDIO IDE — FIREBASE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# Copy this file to `.env.local` and populate with your NEW Firebase Project settings.
#
# ABSOLUTE SAFEGUARD: DO NOT POINT TO ANY EXISTING CODEXA AGENCY PRODUCTION DATABASE!
# The new CodeXa Studio Web database is completely isolated.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE WEB CONFIGURATION (Next.js Public Variables)
# Obtained from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_YOUR_NEW_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=codexa-studio-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=codexa-studio-web
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=codexa-studio-web.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE ADMIN SDK (Strictly Secret - NEVER expose to browser)
# Obtained from: Firebase Console -> Project Settings -> Service accounts -> Generate private key
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=codexa-studio-web
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@codexa-studio-web.iam.gserviceaccount.com
# Use escaped newlines (\n) when pasting private key in single line format:
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. APPLICATION & SECURITY SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. DATABASE ISOLATION & LEGACY SAFEGUARD
# Prevents accidental connection to existing CodeXa Agency databases.
# Comma-separated list of prohibited project IDs that will immediately abort initialization:
# ------------------------------------------------------------------------------
FORBIDDEN_LEGACY_PROJECT_IDS="codxa-agency,codxa-agency-prod,agency-main,codxa-internal"

# Optional read-only member verification endpoint for legacy agency linking (optional/mockable):
LEGACY_AGENCY_VERIFY_ENDPOINT=https://codxa-agency.online/api/verify-member

# ------------------------------------------------------------------------------
# 5. PAYMENT & UPI CONFIGURATION
# ------------------------------------------------------------------------------
DEFAULT_UPI_ID=8897901413-3@axl
NEXT_PUBLIC_DEFAULT_UPI_ID=8897901413-3@axl
YOUPI_UPI_VPA=8897901413-3@axl
DEFAULT_UPI_NAME="CodeXa Agency"

# ------------------------------------------------------------------------------
# 6. FIREBASE EMULATOR CONFIGURATION (Optional - for offline local development)
# Set to 'true' to redirect Auth and Firestore to local emulator ports (9099, 8080)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
